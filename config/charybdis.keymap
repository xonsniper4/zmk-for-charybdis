#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        Base {
            bindings = <
&kp ESCAPE      &kp N1   &kp N2  &kp N3        &kp N4        &kp N5          &kp N6       &kp N7         &kp N8     &kp N9   &kp N0       &kp MINUS
&kp TAB         &kp Q    &kp W   &kp F         &kp P         &kp G           &kp J        &kp L          &kp U      &kp Y    &kp SEMI     &kp APOS
&kp LEFT_SHIFT  &kp A    &kp R   &kp S         &kp T         &kp D           &kp H        &kp N          &kp E      &kp I    &kp O        &lt 1 ENTER
&kp LCTRL       &lt 2 Z  &kp X   &kp C         &kp V         &kp B           &kp K        &kp M          &kp COMMA  &kp DOT  &lt 2 SLASH  &kp DEL
                                 &kp SPACE     &kp LEFT_ALT  &lt 1 CAPSLOCK  &kp UP       &kp BACKSPACE
                                               &kp LEFT      &kp RIGHT       &kp DOWN
            >;
        };

        Lower {
            bindings = <
&kp F12     &kp F1    &kp F2  &kp F3  &kp F4        &kp F5         &kp LPAR       &kp RPAR       &kp LT        &kp GT       &kp KP_MINUS      &kp KP_NUM
&none       &none     &none   &none   &none         &none          &kp RBKT       &kp KP_N7      &kp KP_N8     &kp KP_N9    &kp KP_PLUS       &kp HOME
&none       &none     &none   &none   &kp HOME      &kp PAGE_UP    &kp LBKT       &kp KP_N6      &kp KP_N5     &kp KP_N6    &kp KP_MULTIPLY   &kp PAGE_UP
&none       &none     &none   &none   &kp END       &kp PAGE_DOWN  &kp KP_N0      &kp KP_N1      &kp KP_N2     &kp KP_N3    &kp KP_DIVIDE     &kp PAGE_DOWN
                                      &kp SPACE     &kp LEFT_ALT   &lt 1 CAPSLOCK &kp UP         &kp BACKSPACE
                                                    &kp LEFT       &kp RIGHT      &kp DOWN
            >;
        };

        Raise {
            bindings = <
&kp F12         &kp F1  &kp F2      &kp F3      &kp F4      &kp F5      &kp F6     &kp F7       &kp F8      &kp F9    &kp F10  &kp F11
&bt BT_SEL 0    &none   &none       &mkp MCLK   &none       &none       &none      &none        &mkp MCLK   &none     &none    &none
&bt BT_SEL 1    &none   &mkp RCLK   &none       &mkp LCLK   &none       &none      &mkp LCLK    &none       &mkp RCLK &none    &none
&bt BT_SEL 2    &none   &none       &none       &none       &none       &none      &none        &none       &none     &none    &none
                                                &none       &kp SPACE   &none      &none        &kp BACKSPACE
                                                            &none       &none      &none
            >;
        };

        Mouse {
            bindings = <
&none        &none         &none         &none         &none      &none         &none           &none      &none         &none         &none         &none
&none        &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &none      &bt BT_CLR    &bt BT_CLR      &none      &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &none
&none        &none         &none         &mkp MCLK     &none      &none         &none           &none      &mkp MCLK     &none         &none         &none
&bootloader  &none         &mkp RCLK     &mo 4         &mkp LCLK  &none         &studio_unlock  &mkp LCLK  &mo 4         &mkp RCLK     &none         &bootloader
                                         &none         &mkp LCLK  &mkp RCLK     &mkp RCLK       &mkp LCLK
                                                       &none      &none         &none
            >;
        };

        Scroll {
            bindings = <
&none        &none         &none         &none         &none      &none         &none       &none      &none         &none         &none         &none
&none        &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &none      &bt BT_CLR    &bt BT_CLR  &none      &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &none
&none        &none         &none         &mkp MCLK     &none      &none         &none       &none      &mkp MCLK     &none         &none         &none
&bootloader  &none         &mkp RCLK     &none         &mkp LCLK  &none         &none       &mkp LCLK  &none         &mkp RCLK     &none         &bootloader
                                         &none         &mkp LCLK  &mkp RCLK     &mkp RCLK   &mkp LCLK
                                                       &none      &none         &none
            >;
        };
    };
};
